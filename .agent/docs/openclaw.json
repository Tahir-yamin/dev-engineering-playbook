{
    "gateway": {
        "mode": "local",
        "port": 18789,
        "bind": "lan",
        "auth": {
            "mode": "token",
            "token": "openclaw-token"
        },
        "controlUi": {
            "enabled": true,
            "allowInsecureAuth": true,
            "dangerouslyDisableDeviceAuth": true
        }
    },
    "agents": {
        "defaults": {
            "workspace": "/home/openclaw-runner/.openclaw/workspace",
            "model": {
                "primary": "ollama_local/llama3.2:3b-small"
            }
        }
    },
    "models": {
        "providers": {
            "ollama_local": {
                "baseUrl": "http://172.18.64.1:11434/v1",
                "api": "openai-completions",
                "models": [
                    {
                        "id": "llama3.2:3b-small",
                        "name": "Llama 3.2 3B (Optimized)",
                        "reasoning": false,
                        "input": [
                            "text"
                        ]
                    }
                ]
            }
        }
    }
}